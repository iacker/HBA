digraph bench {
  bgcolor="#15171a";
  fontname="Helvetica";
  fontcolor="#e6e8ea";
  node [fontname="Helvetica", fontcolor="#e6e8ea", color="#333a41",
        style="filled,rounded", shape=box, penwidth=1.4, margin="0.18,0.11"];
  edge [fontname="Helvetica", fontcolor="#9aa3ab", color="#333a41",
        penwidth=1.3, arrowsize=0.75, fontsize=9];
  rankdir=LR; nodesep=0.3; ranksep=0.65;  labelloc="t"; fontsize=15;  label=<<font point-size="15"><b>Why episodic recall stayed on plain SQLite FTS5</b></font><br/><font point-size="10" color="#9aa3ab">25 questions with verified source messages · four configurations · same harness</font><br/> >;  q [fillcolor="#1e2125", color="#6aa9d9", label=<<font point-size="11"><b>question in</b></font><br/><font point-size="11"><b>natural language</b></font>>];
  lex [fillcolor="#17301f", color="#3fa66a", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>lexical FTS5</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">exact identifiers:</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">versions, paths, PIDs</font></td></tr><tr><td align="left"><font point-size="10" color="#3fa66a"><b>2 ms</b></font></td></tr></table>>];
  den [fillcolor="#301715", color="#c2453f", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>dense e5-small</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">384 dim, 5 848 chunks</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">ONNX, no torch</font></td></tr><tr><td align="left"><font point-size="10" color="#c2453f"><b>11 ms</b></font></td></tr></table>>];
  rrf [fillcolor="#1e2125", color="#5a636b", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>RRF fusion</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">k = 60</font></td></tr><tr><td align="left"><font point-size="10" color="#5a636b"><b>18 ms</b></font></td></tr></table>>];
  rr [fillcolor="#1e2125", color="#5a636b", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>cross-encoder</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">ms-marco-MiniLM-L-12</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">0.12 GB, Apache-2.0</font></td></tr><tr><td align="left"><font point-size="10" color="#5a636b"><b>2 244 ms</b></font></td></tr></table>>];
  v1 [fillcolor="#17301f", color="#3fa66a", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>MRR 0.623</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">Hit@1 56% · R@10 80%</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">coverage 20/25</font></td></tr><tr><td align="left"><font point-size="10" color="#3fa66a"><b>KEPT</b></font></td></tr></table>>];
  v2 [fillcolor="#301715", color="#c2453f", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>MRR 0.111</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">Hit@1 8% · R@10 24%</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">coverage 6/25</font></td></tr><tr><td align="left"><font point-size="10" color="#c2453f"><b>rejected</b></font></td></tr></table>>];
  v3 [fillcolor="#301715", color="#c2453f", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>MRR 0.512</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">Hit@1 44% · R@10 68%</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">coverage 17/25</font></td></tr><tr><td align="left"><font point-size="10" color="#c2453f"><b>rejected</b></font></td></tr></table>>];
  v4 [fillcolor="#301715", color="#c2453f", label=<<table border="0" cellborder="0" cellspacing="1"><tr><td align="left"><font point-size="11"><b>MRR 0.510</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">Hit@1 40% · R@10 84%</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">coverage 21/25</font></td></tr><tr><td align="left"><font point-size="10" color="#c2453f"><b>rejected</b></font></td></tr></table>>];
  q -> lex; q -> den;
  lex -> rrf; den -> rrf; rrf -> rr;
  lex -> v1 [style=bold, color="#3fa66a"];
  den -> v2; rrf -> v3; rr -> v4;
  why [fillcolor="#15171a", color="#c2453f", shape=box, style="filled", label=<<table border="0" cellborder="0" cellspacing="2"><tr><td align="left"><font point-size="11" color="#c2453f"><b>why dense loses here</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">similarity over 5 848 chunks:</font></td></tr><tr><td align="left"><font point-size="9" color="#e6e8ea">median 0.807 · max 0.878 · min 0.744</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">the whole corpus fits in 0.13 points, and</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">best-to-p99 is 0.014 to 0.035, so ~60</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">passages are indistinguishable from the</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">right one. A technical history is</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">semantically homogeneous: concepts do not</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">discriminate, exact identifiers do.</font></td></tr></table>>];
  v2 -> why [style=dotted, color="#c2453f", arrowhead=none];
  lever [fillcolor="#15171a", color="#3fa66a", shape=box, style="filled", label=<<table border="0" cellborder="0" cellspacing="2"><tr><td align="left"><font point-size="11" color="#3fa66a"><b>the one remaining lever</b></font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">a lexical oracle built from answer keywords</font></td></tr><tr><td align="left"><font point-size="9" color="#e6e8ea">hits rank 1 in 37 of 37 cases</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">so storage was never the bottleneck. Every</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">failure is a query or ranking failure, and</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">another store cannot help. Fix: put the</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">question vocabulary into the index at write</font></td></tr><tr><td align="left"><font point-size="9" color="#9aa3ab">time. Costs nothing per query.</font></td></tr></table>>];
  v1 -> lever [style=dotted, color="#3fa66a", arrowhead=none];
}
